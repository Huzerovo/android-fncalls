<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".FnCallsApp"
        android:allowBackup="false"
        android:description="@string/xposed_description"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FnCalls">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.RulesActivity"
            android:exported="false"
            android:parentActivityName=".ui.MainActivity" />

        <!--
            Cross-process log sink. Hooked apps run under a different UID, so the
            receiver has to be exported. The caller uses an explicit broadcast;
            Android does not apply package-visibility filtering to broadcast
            sending, which keeps this working without modifying target APKs.
        -->
        <receiver
            android:name=".log.TraceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="moe.huzerovo.fncalls.action.APPEND" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
